                                        <term_definitions code="at0007">
                                            <items id="text">Single plane</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0008">
                                            <items id="text">Biplane</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0009">
                                            <items id="text">Triplane</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0010">
                                            <items id="text">M-mode</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0011">
                                            <items id="text">2D</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0012">
                                            <items id="text">3D</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0013">
                                            <items id="text">Doppler</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0014">
                                            <items id="text">Speckle tracking</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0015">
                                            <items id="text">Simpson's method</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0016">
                                            <items id="text">Teichholz method</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0017">
                                            <items id="text">Devereux method</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0019">
                                            <items id="text">Continuity equation</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0020">
                                            <items id="text">PLAX</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0021">
                                            <items id="text">2 chamber</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0022">
                                            <items id="text">3 chamber</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0023">
                                            <items id="text">4 chamber</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0024">
                                            <items id="text">5 chamber</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0025">
                                            <items id="text">Doppler Method</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0026">
                                            <items id="text">Continuous wave doppler</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0027">
                                            <items id="text">Pulsed wave doppler</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0028">
                                            <items id="text">Tissue doppler</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0030">
                                            <items id="text">Pressure algorithm</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0032">
                                            <items id="text">sPAP = TR Vmax^2 * 4 + RAP</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                        <term_definitions code="at0033">
                                            <items id="text">PSAX</items>
                                            <items id="description"></items>
                                        </term_definitions>
                                    </children>
