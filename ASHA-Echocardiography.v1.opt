                                                        <term_definitions code="at0000.1">
                                                            <items id="text">Imaging examination of a heart</items>
                                                            <items id="description">Findings on radiological examination of a specified body structure or region.</items>
                                                        </term_definitions>
                                                        <term_definitions code="at0.1">
                                                            <items id="text">Aortic root end diastolic diameter at sinuses of Valsalva level</items>
                                                            <items id="description"></items>
                                                        </term_definitions>
                                                        <term_definitions code="at0.2">
                                                            <items id="text">Ascending aorta end diastolic diameter</items>
                                                            <items id="description"></items>
                                                        </term_definitions>
                                                        <term_definitions code="at0.3">
                                                            <items id="text">Aortic valve systolic area</items>
                                                            <items id="description"></items>
